    {"record_id": "r7", "sequence": 9, "role": null, "content_type": "message", "content_kind": "original", "representation": "verbatim_excerpt", "text": "{\"type\": \"name-changed\", \"from\": \"New Bot\", \"to\": \"desk\"}", "occurred_at": "2026-11-08T16:09:00+08:00", "observed_at": "2026-11-08T23:30:00+08:00", "finality": "final", "truncated": false, "gaps": ["system event; role unknown/null"], "delivery_role": "new"},
